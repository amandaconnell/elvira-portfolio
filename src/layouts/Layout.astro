---
import '../styles/global.css'
import '@fontsource/poppins'
import '@fontsource-variable/playfair-display'

import HeaderComponent from '../components/HeaderComponent.astro'
import FooterComponent from '../components/FooterComponent.astro'

const { pageTitle } = Astro.props;
const { isHome = false } = Astro.props;
---

<html lang="sv" class="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{pageTitle}</title>
    <link rel="icon" type="image/x-icon" href="/favicon.ico">
    <script src="https://kit.fontawesome.com/ecf5d3bcbf.js" crossorigin="anonymous"></script>

    <!-- För att undvika FOUC (Flash of Unstyled Content) -->
    <script is:inline>
      {
        (function() {
          try {
            const theme = localStorage.getItem("theme");
            if (theme === "dark" || (!theme && window.matchMedia("(prefers-color-scheme: dark)").matches)) {
              document.documentElement.classList.add("dark");
            } else {
              document.documentElement.classList.remove("dark");
            }
          } catch (e) {}
        })();
      }
    </script>
  
  </head>

  <body class="dark:bg-zinc-900 dark:text-zinc-300 min-h-screen flex flex-col">
    <HeaderComponent isHome={isHome} />

    <main id="main" class={`flex-1 ${isHome ? "min-h-screen" : ""}`}>
      <slot />
    </main>

    <FooterComponent />
  </body>
</html>