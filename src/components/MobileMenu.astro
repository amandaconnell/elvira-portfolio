---
import DropdownLinks from "./DropdownLinks.astro";

const { isHome, menuOpen } = Astro.props;

// För att använda olika klasser på olika sidor
const baseClasses = "xl:hidden border-t border-gray-300 left-0 right-0 top-full z-40 transition-transform duration-300 ease-in-out";
const homeClasses = "bg-white dark:bg-zinc-900 text-black";
const subpageClasses = "bg-white dark:bg-zinc-900";
const openMenuClasses = menuOpen ? "" : "hidden";

const pathname = Astro.url.pathname;

// För att återanvända klasserna och indikera vilken sida användaren befinner sig på
const linkClass = (path: string) => [
  "block px-4 py-2 hover:bg-gray-100 dark:hover:bg-zinc-700 hover:rounded-lg",
  pathname === path && "font-bold",
].filter(Boolean).join(" ");
---

<div
  id="mobile-menu"
  class={`${baseClasses} ${isHome ? homeClasses : subpageClasses} ${openMenuClasses}`}
>
  <ul class="flex flex-col py-4 font-medium text-xl">
    <li><a href="/" class={linkClass("/")} aria-current={pathname === "/" ? "page" : undefined}>Hem</a></li>

    <li>
      <button 
        aria-expanded="false" 
        aria-controls="mobile-dropdown-menu" aria-label="Öppna undermeny"
        class="block px-4 py-2 hover:bg-gray-100 dark:hover:bg-zinc-700 hover:rounded-lg w-full text-left cursor-pointer"
        id="mobile-dropdown-button"
      >
        Portfolio <i id="chevron-mobile" class="fa-solid fa-chevron-down fa-xs"></i>
      </button>

      <ul 
        id="mobile-dropdown-menu" 
        class="hidden gap-2 mt-2 ml-4 pl-4 border-l-2 border-gray-300"
        role="menu"
        aria-labelledby="mobile-dropdown-button"
      >
        <DropdownLinks />
      </ul>
    </li>

    <li><a href="/about/" class={linkClass("/about/")} aria-current={pathname === "/about/" ? "page" : undefined}>Om mig</a></li>
    <li><a href="/contact/" class={linkClass("/contact/")} aria-current={pathname === "/contact/" ? "page" : undefined}>Kontakt</a></li>
  </ul>
</div>

