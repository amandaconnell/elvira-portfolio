<button id="theme-toggle" class="relative w-14 h-7 border rounded-full cursor-pointer focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-fuchsia-500" aria-label="Byt tema">
    <span id="icon-wrapper" class="absolute top-px right-px py-px px-2 rounded-full transition-transform duration-300"><i class="fa-solid fa-moon fa-xs fa-rotate-by" style="--fa-rotate-angle: 230deg;"></i></span>
</button>

<script>
    const themeToggle = document.getElementById('theme-toggle');
    const iconWrapper = document.getElementById('icon-wrapper');
    const html = document.documentElement;

    function updateTogglePosition() {
        if (html.classList.contains('dark')) {
            iconWrapper?.classList.remove('-translate-x-6'); // Flyttar ikonen åt vänster
        } else {
            iconWrapper?.classList.add('-translate-x-6'); // Flyttar ikonen åt höger
        }
    }
    
    document.addEventListener('DOMContentLoaded', updateTogglePosition);

    // När sidan laddas hämtas sparat val annars visas mörkt läge
    if (localStorage.getItem('theme') === 'light') {
        html.classList.remove('dark');
    } else {
        html.classList.add('dark');
    }

    themeToggle?.addEventListener('click', () => {
        if (html.classList.contains('dark')) {
            html.classList.remove('dark'); // Byter till ljust tema
            localStorage.setItem('theme', 'light');
        } else {
            html.classList.add('dark'); // Byter till mörkt tema
            localStorage.setItem('theme', 'dark');
        }
        updateTogglePosition();
    });
</script>