---
const { pageTitle } = Astro.props;
---

<div class="my-12">
    <div class="flex flex-col items-center gap-10 mb-16">
        <h1 class="font-secondary text-6xl font-bold">{pageTitle}</h1>
        <p class="w-[670px]">En kort beskrivning här om bilderna/motiven, om det känns relevant, annars går det också att utesluta den här delen helt och bara fokusera på bilderna.</p>
    </div>
    <!-- Bildgalleri -->
    <div class="columns-4 gap-4 space-y-4">
        <img class="h-auto" src="https://placehold.co/600x400" alt="">
        <img class="h-auto" src="https://placehold.co/400x400" alt="">
        <img class="h-auto" src="https://placehold.co/400x500" alt="">
        <img class="h-auto" src="https://placehold.co/400x500" alt="">
        <img class="h-auto" src="https://placehold.co/400x400" alt="">
        <img class="h-auto" src="https://placehold.co/600x400" alt="">
        <img class="h-auto" src="https://placehold.co/400x400" alt="">
        <img class="h-auto" src="https://placehold.co/400x500" alt="">
        <img class="h-auto" src="https://placehold.co/600x400" alt="">
        <img class="h-auto" src="https://placehold.co/400x500" alt="">
        <img class="h-auto" src="https://placehold.co/600x400" alt="">
        <img class="h-auto" src="https://placehold.co/400x400" alt="">
    </div>
</div>