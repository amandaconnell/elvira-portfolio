---
import GalleryComponent from "../components/GalleryComponent";
import albums from "../data/albums.json";

const { pageTitle, category } = Astro.props;

const images = albums[category as keyof typeof albums] ?? [];
---

<div class="mt-12 mb-20 sm:my-12 mx-4 md:mx-8 xl:mx-16">
    <div class="flex flex-col items-center gap-10 mb-8 md:mb-16">
        <h1 class="font-secondary text-6xl font-bold">{pageTitle}</h1>
        <p class="sm:w-[670px]">En kort beskrivning här om bilderna/motiven, om det känns relevant, annars går det också att utesluta den här delen helt och bara fokusera på bilderna.</p>
    </div>
    
    <GalleryComponent images={images} client:load />
</div>
