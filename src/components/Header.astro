---
import Navigation from "./Navigation.astro"
import MobileMenu from "./MobileMenu.astro"
import ThemeToggle from "./ThemeToggle.astro"
---

<div class="flex justify-between items-center py-6">
  <a href="/" class="flex items-center gap-3">
    <!-- Logo för mörkt tema -->
    <img src="/src/logo-white.png" alt="Elvira Holmberg logotyp" class="hidden dark:block h-[55px]">
    <!-- Logo för ljust tema -->
    <img src="/src/logo-black.png" alt="Elvira Holmberg logotyp" class="block dark:hidden h-[55px]">
    <div class="flex flex-col">
      <p class="font-bold text-2xl">ELVIRA HOLMBERG</p>
      <p>FOTOGRAF</p>
    </div>
  </a>
  <div class="flex gap-4 xl:gap-12">
    <ThemeToggle />
    <Navigation />
  </div>
</div>

<MobileMenu />