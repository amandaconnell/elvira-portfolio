---
import Navigation from "./Navigation.astro"
import MobileMenu from "./MobileMenu.astro"
import ThemeToggle from "./ThemeToggle.astro"

const { isHome } = Astro.props;
---

<header class={`flex justify-between items-center py-6 bg-transparent w-full z-50 ${isHome ? 'fixed top-0 left-0 text-white' : 'relative'}`}>
  <a href="/" class="flex items-center gap-3 ml-4 xl:ml-16">
    {isHome ? (
      // Visar alltid vit logotyp på startsidan
      <img src="/src/logo-white.png" alt="Elvira Holmberg logotyp" class="h-[55px]" />
    ) : (
      // På övriga visas logotyp baserad på mörkt eller ljust tema
      <>
        <img src="/src/logo-white.png" alt="Elvira Holmberg logotyp" class="hidden dark:block h-[55px]" />
        <img src="/src/logo-black.png" alt="Elvira Holmberg logotyp" class="block dark:hidden h-[55px]" />
      </>
    )}
    <div class="flex flex-col">
      <p class="font-bold text-xl sm:text-2xl">ELVIRA HOLMBERG</p>
      <p class="text-sm sm:text-base">FOTOGRAF</p>
    </div>
  </a>
  <div class="flex gap-2 ml-6 sm:gap-4 mr-4 xl:mr-16 lg:gap-12">
    {!isHome && <ThemeToggle />}
    <Navigation />
  </div>
</header>

<MobileMenu />