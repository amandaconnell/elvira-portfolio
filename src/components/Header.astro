---
import Navigation from "./Navigation.astro"
import MobileMenu from "./MobileMenu.astro"
import ThemeToggle from "./ThemeToggle.astro"

const { isHome = false } = Astro.props;
---

<header class={`flex justify-between items-center py-6 mx-4 xl:mx-16 bg-transparent w-screen z-50 ${isHome ? 'fixed top-0 left-0 text-white' : 'relative'}`}>
  <a href="/" class="flex items-center gap-3">
    <!-- Logo för mörkt tema -->
    <img src="/src/logo-white.png" alt="Elvira Holmberg logotyp" class="hidden dark:block h-[55px]">
    <!-- Logo för ljust tema -->
    <img src="/src/logo-black.png" alt="Elvira Holmberg logotyp" class="block dark:hidden h-[55px]">
    <div class="flex flex-col">
      <p class="font-bold text-xl sm:text-2xl">ELVIRA HOLMBERG</p>
      <p class="text-sm sm:text-base">FOTOGRAF</p>
    </div>
  </a>
  <div class="flex gap-2 ml-6 sm:gap-4 mr-4 xl:mr-16 lg:gap-12">
    {!isHome && <ThemeToggle />}
    <Navigation />
  </div>
</header>

<MobileMenu />