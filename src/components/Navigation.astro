---
import DropdownLinks from "./DropdownLinks.astro"
const pathname = Astro.url.pathname;

// För att återanvända klasserna och indikera vilken sida användaren befinner sig på
const linkClass = (path: string) => [
  "focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-fuchsia-500",
  pathname === path && "pb-2 border-b-2",
].filter(Boolean).join(" ");
---

<nav>
  <ul id="nav-links" class="hidden lg:flex gap-12 font-medium text-xl items-center">
    <li class="hover:font-bold"><a href="/" class={linkClass("/")} aria-current={pathname === "/" ? "page" : undefined}>Hem</a></li>

    <li class="relative w-full lg:w-auto">
      <button 
        aria-expanded="false" 
        aria-controls="dropdown-menu" aria-label="Öppna undermeny"
        class="w-full text-left hover:font-bold xl:text-center focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-fuchsia-500"
        id="dropdown-button">
          Portfolio <i id="chevron-desktop" class="fa-solid fa-chevron-down fa-xs"></i>
      </button>
      
      <ul 
        id="dropdown-menu" 
        class="hidden bg-white text-black dark:bg-zinc-900 dark:text-zinc-300 rounded py-0 lg:absolute lg:mt-0 lg:top-12 lg:left-0 lg:w-48 z-50"
        role="menu"
        aria-labelledby="dropdown-button">
          <DropdownLinks />
        </ul>
    </li>

    <li class="hover:font-bold"><a href="/about/" class={linkClass("/about/")} aria-current={pathname === "/about/" ? "page" : undefined}>Om mig</a></li>
    <li class="hover:font-bold"><a href="/contact/" class={linkClass("/contact/")} aria-current={pathname === "/contact/" ? "page" : undefined}>Kontakt</a></li>
  </ul>
</nav>

<!-- Knapp för att öppna mobilmenyn -->
<button id="mobile-menu-button" class="lg:hidden transition-transform duration-300 ease-in-out cursor-pointer focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-fuchsia-500" aria-label="Öppna meny">
  <svg class="w-8 h-8" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
    <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M9 18h11"></path>
  </svg>
</button>

<script>
  const mobileMenuButton = document.getElementById("mobile-menu-button");
  const mobileMenu = document.getElementById("mobile-menu");
  const dropdownButton = document.getElementById("dropdown-button");
  const dropdownMenu = document.getElementById("dropdown-menu");
  const mobileDropdownMenu = document.getElementById("mobile-dropdown-menu");
  const mobileDropdownButton = document.getElementById("mobile-dropdown-button");

  const menuSVG = `<svg class="w-8 h-8" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
    <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M9 18h11"></path>
  </svg>`;

  const closeSVG = `<svg class="w-8 h-8" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round">
    <line x1="6" y1="6" x2="18" y2="18" />
    <line x1="6" y1="18" x2="18" y2="6" />
  </svg>`;

  const desktopDropdownIcon = document.getElementById("chevron-desktop");
  const mobileDropdownIcon = document.getElementById("chevron-mobile");

  function setIconState(dropdownIcon: HTMLElement | null, isOpen: any) {
    if (!dropdownIcon) return;
    if (isOpen) {
      dropdownIcon.classList.add("fa-chevron-up");
      dropdownIcon.classList.remove("fa-chevron-down");
    } else {
      dropdownIcon.classList.add("fa-chevron-down");
      dropdownIcon.classList.remove("fa-chevron-up");
    }
  }

  function setDesktopIconState(isOpen: boolean) {
    setIconState(desktopDropdownIcon, isOpen);
  }

  function setMobileIconState(isOpen: boolean) {
    setIconState(mobileDropdownIcon, isOpen);
  }

  function applyNavbarState(menuOpen: boolean) {
    const navbar = document.getElementById("navbar");
    const logo = document.getElementById("eh-logo") as HTMLImageElement | null;
    const isHome = window.location.pathname === "/" || window.location.pathname === "/index.html";

    const theme = localStorage.getItem("theme") ?? "light";
    const darkTheme = theme === "dark";

    if (!navbar || !logo) return;

    if (menuOpen) {
      navbar.classList.remove("bg-transparent", "text-white");
      navbar.classList.add("bg-white", "text-black", "dark:bg-zinc-900", "dark:text-zinc-300");
      
      logo.src = darkTheme ? "/images/logo-white.png" : "/images/logo-black.png";
    } else {
      if (isHome) {
        navbar.classList.remove("bg-white", "text-black", "dark:bg-zinc-900", "dark:text-zinc-300");
        navbar.classList.add("bg-transparent", "text-white");

        logo.src = "/images/logo-white.png";
      } else {
        navbar.classList.remove("bg-transparent", "text-white");
        navbar.classList.add("bg-white", "text-black", darkTheme ? "dark:bg-zinc-900 dark:text-zinc-300" : "");

        logo.src = darkTheme ? "/images/logo-white.png" : "/images/logo-black.png";
      } 
    }
  }

  // Öppnar mobilmenyn och skiftar ikon
  mobileMenuButton?.addEventListener("click", () => {
    mobileMenu?.classList.toggle("hidden");
    const menuOpen = !(mobileMenu?.classList.contains("hidden") ?? true);
    
    mobileMenuButton.style.transition = "opacity 0.2s ease";
    mobileMenuButton.style.opacity = "0";

    setTimeout(() => {
      mobileMenuButton.innerHTML = menuOpen ? closeSVG : menuSVG;
      mobileMenuButton.style.opacity = "1";
    }, 200);

    applyNavbarState(menuOpen);
  });

  // Öppnar undermenyn inuti mobilmenyn
  mobileDropdownButton?.addEventListener("click", (e) => {
    e.stopPropagation();
    const expanded = mobileDropdownButton.getAttribute("aria-expanded") === "true";
    const newState = !expanded;
    mobileDropdownButton.setAttribute("aria-expanded", String(newState));
    mobileDropdownMenu?.classList.toggle("hidden");
    setMobileIconState(newState);
  });

  // Stänger mobilmenyns undermeny när man klickar utanför undermenyn
  document.addEventListener("click", (event) => {
    const target = event.target;
    if (target instanceof Node) {
      const isOpen = mobileDropdownButton?.getAttribute("aria-expanded") === "true";
      if (
        isOpen &&
        !mobileDropdownMenu?.contains(target) &&
        !mobileDropdownButton?.contains(target)
      ) {
        mobileDropdownMenu?.classList.add("hidden");
        mobileDropdownButton?.setAttribute("aria-expanded", "false");
        setMobileIconState(false);
      }
    }
  });

  // Öppnar undermenyn på desktop
  dropdownButton?.addEventListener("click", (e) => {
    e.stopPropagation();
    const expanded = dropdownButton.getAttribute("aria-expanded") === "true";
    const newState = !expanded;
    dropdownButton.setAttribute("aria-expanded", String(newState));
    dropdownMenu?.classList.toggle("hidden");
    setDesktopIconState(newState);
  });

  // Stänger undermenyn när man klickar utanför på desktop
  document.addEventListener("click", (event) => {
    const target = event.target;
    if (target instanceof Node) {
      const isOpen = dropdownButton?.getAttribute("aria-expanded") === "true";
      if (
        isOpen &&
        !dropdownMenu?.contains(target) &&
        !dropdownButton?.contains(target)
      ) {
        dropdownMenu?.classList.add("hidden");
        dropdownButton?.setAttribute("aria-expanded", "false");
        setDesktopIconState(false);
      }
    }
  });
</script>