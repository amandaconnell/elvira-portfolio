---
const pathname = Astro.url.pathname;

// För att återanvända klasserna och indikera vilken sida användaren befinner sig på
const linkClass = (path: string) => [
  "block px-4 py-2 lg:py-4 hover:bg-gray-100 hover:rounded-lg dark:hover:bg-zinc-700 focus-visible:outline-none focus-visible:border-l-12 focus-visible:bg-gray-100 focus-visible:dark:bg-zinc-700 focus-visible:border-fuchsia-500",
  pathname === path && "font-bold",
].filter(Boolean).join(" ");
---

<li><a href="/flora/" class={linkClass("/flora/")} aria-current={pathname === "/flora/" ? "page" : undefined}>Flora</a></li>
<li><a href="/fauna/" class={linkClass("/fauna/")} aria-current={pathname === "/fauna/" ? "page" : undefined}>Fauna</a></li>
<li><a href="/landskap/" class={linkClass("/landskap/")} aria-current={pathname === "/landskap/" ? "page" : undefined}>Landskap</a></li>
<li><a href="/fyrfota/" class={linkClass("/fyrfota/")} aria-current={pathname === "/fyrfota/" ? "page" : undefined}>Fyrfota</a></li>
<li><a href="/nattetid/" class={linkClass("/nattetid/")} aria-current={pathname === "/nattetid/" ? "page" : undefined}>Nattetid</a></li>

<div class="focus-visible:dark"></div>