---
import Layout from "../layouts/Layout.astro"
const pageTitle = "Kontakt"
---

<Layout pageTitle={pageTitle}>
    <div class="flex flex-col md:flex-row gap-12 md:gap-0 justify-evenly mt-12 mb-20 mx-4 md:mx-8 xl:mx-16">
        <div class="flex flex-col gap-8">
            <h1 class="font-secondary text-6xl font-bold">{pageTitle}</h1>
            <div>
                <i class="fa-solid fa-square-envelope fa-2xl"></i>
                <a href="mailto:elviraholmb@gmail.com" class="focus-visible:outline-2 focus-visible:outline-offset-4 
                focus-visible:outline-fuchsia-500">elviraholmb@gmail.com</a>
            </div>
            <img src={`${import.meta.env.BASE_URL}images/full/fauna/img10.webp`} alt="En sjö med två svanar som är vända mot varandra. Ytterligare fyra svanar syns i bakgrunden." 
            class="hidden md:inline md:w-65 lg:w-95 xl:w-120">
        </div>
        
        <form action="" id="contact-form" class="flex flex-col" autocomplete="on" novalidate>
            <label for="sender-name">Namn</label>
            <input type="text" name="sender-name" id="sender-name" aria-describedby="name-error" aria-invalid="false"
             class="p-2 md:w-94 border rounded-sm user-valid:border-green-600 user-invalid:border-red-600 
             focus-visible:outline-2 focus-visible:outline-fuchsia-500" required>
            <p id="name-error" class="text-red-600 text-sm"></p>

            <label for="sender-email" class="mt-6">Email</label>
            <input type="email" name="sender-email" id="sender-email" aria-describedby="email-error" 
            aria-invalid="false" class="p-2 md:w-94 border rounded-sm user-valid:border-green-600 
            user-invalid:border-red-600 focus-visible:outline-2 focus-visible:outline-fuchsia-500" required>
            <p id="email-error" class="text-red-600 text-sm"></p>

            <label for="message" class="mt-6">Meddelande</label>
            <textarea name="message" id="message" aria-describedby="message-error" aria-invalid="false" 
            class="p-2 md:w-94 border rounded-sm user-valid:border-green-600 user-invalid:border-red-600
            focus-visible:outline-2 focus-visible:outline-fuchsia-500" 
            rows="8" required></textarea>
            <p id="message-error" class="text-red-600 text-sm"></p>
            
            <button type="submit" class="flex self-start border rounded-full py-2 px-4 mt-6 cursor-pointer shadow-md 
            shadow-neutral-500/30 transition hover:translate-y-0.5 active:scale-95 focus-visible:outline-2 
            focus-visible:outline-offset-4 focus-visible:outline-fuchsia-500">
                Skicka meddelande</button>
        </form>
    </div>
</Layout>

<script>
    const form = document.getElementById("contact-form") as HTMLFormElement;

    form.addEventListener("submit", (e) => {
        e.preventDefault();

        const errors = {
            name: document.getElementById("name-error")!,
            email: document.getElementById("email-error")!,
            message: document.getElementById("message-error")!,
        }

        const fields = {
            name: document.getElementById("sender-name") as HTMLInputElement,
            email: document.getElementById("sender-email") as HTMLInputElement,
            message: document.getElementById("message") as HTMLInputElement,
        }

        // För att rensa tidigare felmeddelanden
        Object.values(errors).forEach(e => e.textContent = "");
        Object.values(errors).forEach(f => f.setAttribute("aria-invalid", "false"));

        const formData = new FormData(form);
        const name = formData.get("sender-name")?.toString().trim() || "";
        const email = formData.get("sender-email")?.toString().trim() || "";
        const message = formData.get("message")?.toString().trim() || "";

        let containsError = false;

        if (!name) {
            errors.name.innerHTML = `<i class="fa-solid fa-exclamation"></i> Fyll i ett namn`;
            fields.name.setAttribute("aria-invalid", "true");
            containsError = true;
        }

        if (!email) {
            errors.email.innerHTML = `<i class="fa-solid fa-exclamation"></i> Fyll i en emailadress`;
            fields.email.setAttribute("aria-invalid", "true");
            containsError = true;
        } else if (!/^\S+@\S+\.\S+$/.test(email)) {
            errors.email.innerHTML = `<i class="fa-solid fa-exclamation"></i> Fyll i en giltig emailadress`;
            fields.email.setAttribute("aria-invalid", "true");
            containsError = true;
        }

        if (!message) {
            errors.message.innerHTML = `<i class="fa-solid fa-exclamation"></i> Fyll i ett meddelande`;
            fields.message.setAttribute("aria-invalid", "true");
            containsError = true;
        }

        if (!containsError) {
            form.reset();
        }
    })
</script>
