---
import Layout from "../layouts/Layout.astro"
const pageTitle = "Elvira Holmberg"
---

<Layout pageTitle={pageTitle}>
    <div class="flex mb-6 z-10">
        <div class="h-screen relative flex-2 hover:flex-6 transition-all duration-500 ease-out">
            <img class="object-cover h-full w-full shadow-xl" src="https://placehold.co/600x400" alt="">
            <a href="/one/"><h2 class="absolute bottom-24 left-1/2 transform -translate-x-1/2 font-secondary text-6xl font-bold">1</h2></a>
        </div>
        <div class="h-screen relative flex-2 hover:flex-6 transition-all duration-500 ease-out">
            <img class="object-cover h-full w-full shadow-xl" src="https://placehold.co/600x400" alt="">
            <a href="/two/"><h2 class="absolute bottom-24 left-1/2 transform -translate-x-1/2 font-secondary text-6xl font-bold">2</h2></a>
        </div>
        <div class="h-screen relative flex-2 hover:flex-6 transition-all duration-500 ease-out">
            <img class="object-cover h-full w-full shadow-xl" src="https://placehold.co/600x400" alt="">
            <a href="/three/"><h2 class="absolute bottom-24 left-1/2 transform -translate-x-1/2 font-secondary text-6xl font-bold">3</h2></a>
        </div>
        <div class="h-screen relative flex-2 hover:flex-6 transition-all duration-500 ease-out">
            <img class="object-cover h-full w-full shadow-xl" src="https://placehold.co/600x400" alt="">
            <a href="/four/"><h2 class="absolute bottom-24 left-1/2 transform -translate-x-1/2 font-secondary text-6xl font-bold">4</h2></a>
        </div>
        <div class="h-screen relative flex-2 hover:flex-6 transition-all duration-500 ease-out">
            <img class="object-cover h-full w-full shadow-xl" src="https://placehold.co/600x400" alt="">
            <a href="/five/"><h2 class="absolute bottom-24 left-1/2 transform -translate-x-1/2 font-secondary text-6xl font-bold">5</h2></a>
        </div>
    </div>
</Layout>


