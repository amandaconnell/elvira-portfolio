---
import Carousel from '../components/Carousel.tsx';
import Layout from '../layouts/Layout.astro';

const pageTitle = "Elvira Holmberg"
const panels = [
  {
    imageSrc: "images/full/flora/img09.webp",
    altText: "Tre röda blåsippor står på rad lodrätt med mörkt gröna blad och mossa i bakgrunden.",
    category: "Flora",
    linkHref: "flora/",
  },
  {
    imageSrc: "images/full/fauna/img01.webp",
    altText: "En groda i närbild, sittandes på ett näckrosblad. Endast huvudet sticker upp från vattenytan.",
    category: "Fauna",
    linkHref: "fauna/",
  },
  {
    imageSrc: "images/full/landskap/img12.webp",
    altText: "En orange solnedgång över en sjö med dramatiska moln på himlen.",
    category: "Landskap",
    linkHref: "landskap/",
  },
  {
    imageSrc: "images/full/fyrfota/img05.webp",
    altText: "En röd och vit katt med ett svart öra tittar mot kameran.",
    category: "Fyrfota",
    linkHref: "fyrfota/",
  },
  {
    imageSrc: "images/full/nattetid/img02.webp",
    altText: "Ett stjärnfall på en himmel täckt av stjärnor över en snötäckt sjö med träd vid horisonten.",
    category: "Nattetid",
    linkHref: "nattetid/",
  },
];
---

<Layout isHome={true} pageTitle={pageTitle}>
    <Carousel client:load panels={panels} />
</Layout>
