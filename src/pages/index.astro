---
import Layout from "../layouts/Layout.astro"
import CategoryPanel from "../components/CategoryPanel.astro"

const pageTitle = "Elvira Holmberg"
const panels = [
    { imageSrc: '/src/frog.jpg', altText: 'Frog', category: 'Djur', linkHref: '/one/' },
    { imageSrc: '/src/lizard.jpg', altText: 'Lizard', category: 'Natur', linkHref: '/two/' },
    { imageSrc: '/src/moon.jpg', altText: 'Moon', category: 'Landskap', linkHref: '/three/' },
    { imageSrc: '/src/frog.jpg', altText: 'Frog', category: 'Djur', linkHref: '/one/' },
    { imageSrc: '/src/lizard.jpg', altText: 'Lizard', category: 'Natur', linkHref: '/two/' },
];
---

<Layout isHome={true} pageTitle={pageTitle}>
    <div class="flex mb-12 z-10 text-white">
        <div class="hidden lg:flex">
            {panels.map(panel => (
                <CategoryPanel
                    imageSrc={panel.imageSrc}
                    altText={panel.altText}
                    category={panel.category}
                    linkHref={panel.linkHref}
                />
            ))}
        </div>
        <div class="lg:hidden">
            <div>
            </div>
        </div>
    </div>
</Layout>


